# Supabase (projeto CRM)
SUPABASE_URL=https://vrnejhzsugrcedzbwbnj.supabase.co
SUPABASE_KEY=your_service_role_key_here

# Flask Security
SECRET_KEY=generate_with_python_secrets_token_hex_32
FERNET_KEY=generate_with_cryptography_fernet_generate_key

# Evolution API (para alertas WhatsApp dos sócios)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Porta
PORT=5010

# URLs dos projetos monitorados (trocar pelas URLs reais do Coolify)
HEALTH_URL_PREFEITURA=https://prefeitura.nodedata.com.br/api/health
HEALTH_URL_ATACAFORTE=https://atacaforte.nodedata.com.br/api/health
DASHBOARD_URL_PREFEITURA=https://prefeitura.nodedata.com.br
DASHBOARD_URL_ATACAFORTE=https://atacaforte.nodedata.com.br

# Número do João para receber alertas WhatsApp (DDI+DDD+número)
ALERT_WHATSAPP_PHONE=5544999999999

# Intervalo entre checagens automáticas (segundos). 300 = 5 min
HEALTH_CHECK_INTERVAL=300

# Telegram — canal interno dos sócios (webhook em /webhook/telegram)
# 1. Crie o bot em @BotFather e coloque o token abaixo
# 2. Adicione o bot ao grupo privado dos sócios, pegue o chat.id em getUpdates
# 3. Gere um secret aleatório (32+ chars) e registre via setWebhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=
